# Copy this file to .env and fill in your values. Do NOT commit .env.

# Discord Bot Token (from Discord Developer Portal)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Comma-separated role names allowed to use bot commands
BOT_ALLOWED_ROLES=Administrator,Moderator

# Rate limit in seconds between commands per user (default: 10)
RATE_LIMIT_SECONDS=10

# Optional: Discord Webhook URL for structured logging
LOG_WEBHOOK_URL=
